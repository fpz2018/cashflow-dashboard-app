        if (debtor.isSystem) return;
        setEditingId(debtor.id);
        setNewItem({ name: debtor.name, paymentTerm: debtor.paymentTerm });
    }, []);

    const handleCancelEdit = useCallback(() => {
        setEditingId(null);
        setNewItem({ name: '', paymentTerm: 30 });
